# Copy this file to .env (in the same server/ folder) and fill in your values.
# Never commit the real .env file. Placeholders only — no real secrets here.

# development | production (production enables extra startup checks)
NODE_ENV=development

# Express server port
PORT=5000

# Browser origins allowed to call the API (CORS), comma-separated: the user portal AND the admin portal.
# Required when NODE_ENV=production, e.g. https://lifelink.example.com,https://admin.lifelink.example.com
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lifepro

# Optional: encrypted connection for hosted MySQL servers that require TLS.
# DB_SSL_CA is the path to the provider's CA certificate (.pem), if they give you one.
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem

# Secret used to sign JWT login tokens — a long random value.
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=change_this_in_production

# ---------------------------------------------------------------------
# Optional hardening / operations settings (defaults shown)
# ---------------------------------------------------------------------
# Behind a reverse proxy: number of proxy hops to trust, so rate limits see the real client IP
# TRUST_PROXY=1

# One line per request (method, path without query string, status, time). Never logs bodies or tokens.
# LOG_REQUESTS=true

# Sign-in protection: failed attempts allowed per 15 minutes (per account+IP, and per IP)
# RATE_LIMIT_LOGIN_FAILURES=10
# RATE_LIMIT_LOGIN_FAILURES_PER_IP=50

# New accounts allowed per IP per hour (raise it in development if test runs get throttled)
# RATE_LIMIT_REGISTER_PER_HOUR=30
