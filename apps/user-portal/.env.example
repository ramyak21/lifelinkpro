# Copy to apps/user-portal/.env to override. Read at build time (npm run dev / npm run build).
# Everything here is PUBLIC — it is compiled into the browser bundle. Never put secrets in VITE_* variables.

# Base URL of the LifeLink Pro API (default: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Address of the admin portal, shown to administrators as a link.
# `npm run dev` defaults to http://localhost:5174; production builds show no link unless this is set.
VITE_ADMIN_PORTAL_URL=http://localhost:5174
