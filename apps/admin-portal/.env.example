# Copy to apps/admin-portal/.env to override. Read at build time (npm run dev / npm run build).
# Everything here is PUBLIC — it is compiled into the browser bundle. Never put secrets in VITE_* variables.
# Admin rights are enforced by the API, never by this app's configuration.

# Base URL of the LifeLink Pro API (default: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Address of the user portal, linked from the admin top bar ("View site").
# `npm run dev` defaults to http://localhost:5173; production builds show no link unless this is set.
VITE_USER_PORTAL_URL=http://localhost:5173
